// Creators — K-12 microschool marketplace (showcase excerpt).
// Money is always integer cents. Students and schools are described by AGE, never by grade level.
// COPPA: Kid has NO email, phone, photo or location fields. Keep it that way.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARENT
  FACILITATOR
  ADMIN
}

enum BackgroundCheckStatus {
  NOT_STARTED
  PENDING
  CLEAR
  FAILED
  EXPIRED
}

enum ApprovalStatus {
  APPLIED
  APPROVED
  REJECTED
}

enum SchoolFormat {
  IN_PERSON
  VIRTUAL
  HYBRID
}

enum EnrollmentStatus {
  REQUESTED
  ACCEPTED
  WAITLISTED
  DECLINED
  ACTIVE
  PAUSED
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?
  roles           Role[]    @default([])
  suspended       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  kids                 Kid[]
  facilitatorProfile   FacilitatorProfile?
  sessions             UserSession[]

  @@index([suspended])
}

model Kid {
  id                String    @id @default(cuid())
  parentId          String
  firstName         String
  birthYear         Int
  username          String    @unique
  pinHash           String
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
}

model UserSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model FacilitatorProfile {
  id                       String                @id @default(cuid())
  userId                   String                @unique
  bio                      String?
  backgroundCheckStatus    BackgroundCheckStatus @default(NOT_STARTED)
  approvalStatus           ApprovalStatus        @default(APPLIED)
  stripeAccountId          String?               @unique
  payoutsReady             Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schools School[]
}

model School {
  id                 String        @id @default(cuid())
  facilitatorId      String
  slug               String        @unique
  name               String
  description        String
  format             SchoolFormat
  capacity           Int
  tuitionCents       Int
  status             String        @default("DRAFT")
  agesMin            Int           @default(5)
  agesMax            Int           @default(18)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  facilitator FacilitatorProfile @relation(fields: [facilitatorId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([facilitatorId])
}

model Enrollment {
  id            String           @id @default(cuid())
  kidId         String
  schoolId      String
  status        EnrollmentStatus @default(REQUESTED)
  tuitionCents  Int?
  discountPct   Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  kid      Kid      @relation(fields: [kidId], references: [id], onDelete: Cascade)
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([kidId])
  @@index([schoolId, status])
}

model Payment {
  id               String        @id @default(cuid())
  enrollmentId     String
  amountCents      Int
  platformFeeCents Int
  status           PaymentStatus @default(PENDING)
  periodStart      DateTime      @db.Date
  periodEnd        DateTime      @db.Date
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, periodStart])
  @@index([status])
}

// Additional models (Location, ComplianceItem, MessageThread, Booking, etc.)
// follow the same patterns: ownership checks, soft deletes where appropriate,
// and clear public vs private fields.
