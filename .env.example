# Copy to .env.local for local development. Never commit real values.
DATABASE_URL=postgresql://creators:CHANGE_ME@127.0.0.1:5432/creators_dev
APP_URL=http://127.0.0.1:3000
UPLOAD_DIR=./.uploads
# COOKIE_SECURE=false            # defaults to true only when NODE_ENV=production
# GOOGLE_CLIENT_ID=              # shows the Google sign-in stub when set
# STRIPE_SECRET_KEY=             # absent => test payments adapter
# BACKGROUND_CHECK_API_KEY=      # absent => test background-check adapter
# EMAIL_API_KEY=                 # absent => EmailOutbox-only adapter
# TEST_PAYMENTS_FAIL=1           # force every test charge to fail
# SESSION_SECRET=                # long random string for view-as signing
