{
  "name": "creators",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "test": "node --conditions=react-server --test \"test/*.test.ts\"",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@livekit/components-react": "2.9.25",
    "@livekit/components-styles": "1.2.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "livekit-client": "2.24.1",
    "livekit-server-sdk": "2.20.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "11.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
